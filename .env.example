# ============================================
#  Teknikerkalender – miljøvariabler
# ============================================
# Kopier denne filen til ".env" og fyll inn egne verdier.
# ALDRI last opp den ferdig utfylte ".env"-filen til git eller del den.
#
# Bruker du Coolify? Se docker-compose.yml og README.md — der genereres
# de fleste av disse verdiene automatisk, og du trenger ikke denne filen
# i det hele tatt (bortsett fra evt. Google/Microsoft-feltene).

# Hvilken port serveren skal lytte på (deploy-panelet ditt setter
# som regel denne selv og ruter trafikk til den)
PORT=3000

# Navn og undertekst som vises i UI og i kalenderen
SITE_NAVN=Teknikeransvar
SITE_UNDERTEKST=Se hvilken søndag du har teknikeransvar på møte.

# Hvor lenge et møte varer (minutter) i kalenderoppføringen
MOTE_VARIGHET_MIN=120

# Brukes til å signere innloggingsøkter (sessions). Sett til en lang,
# tilfeldig streng – f.eks. kjør: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=bytt-denne-til-noe-tilfeldig-og-langt

# ---- Passord ----
# To måter å sette disse på:
#   1) Klartekst (ADMIN_PASSORD / TEAM_PASSORD) — appen hasher dette
#      automatisk ved oppstart. Bruk dette på Coolify, hvor passordet kan
#      genereres automatisk av deploy-panelet (se docker-compose.yml).
#   2) Ferdig bcrypt-hash (ADMIN_PASSORD_HASH / TEAM_PASSORD_HASH) — lag
#      med "npm run generate-hash". Bruk dette hvis du foretrekker å
#      aldri ha klartekst-passordet liggende noe sted, selv midlertidig
#      i miljøvariabler.
# Sett ALDRI begge for samme rolle — hash-varianten vinner hvis begge er satt.
ADMIN_PASSORD=
ADMIN_PASSORD_HASH=
TEAM_PASSORD=
TEAM_PASSORD_HASH=

# ---- Hemmelige nøkler for lenker uten innlogging ----
# Kalenderfeed og live-visning kan ikke bruke passord-innlogging
# (kalender-apper og lobbyskjermer logger ikke inn), så disse lenkene
# beskyttes med en lang tilfeldig nøkkel i stedet.
# Generer med: node -e "console.log(require('crypto').randomBytes(20).toString('base64url'))"
FEED_NOKKEL=
LIVE_NOKKEL=

# Brukes i unike ID-er i kalenderfeeden – kan stå som den er, eller
# byttes til ditt eget domene
KALENDER_DOMENE=teknikerkalender.local

# ---- Google-innlogging (valgfritt) ----
GOOGLE_PALOGGET=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Microsoft Entra ID-innlogging (valgfritt) ----
MS_PALOGGET=false
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common

# ---- Hvem har lov å logge inn med Google/Microsoft? ----
# Kommaseparerte lister. Tomme lister betyr at SSO alltid nekter
# innlogging, selv om GOOGLE_PALOGGET/MS_PALOGGET er true.
TEAM_TILLATTE_EPOSTER=
TEAM_TILLATTE_DOMENER=
ADMIN_TILLATTE_EPOSTER=
ADMIN_TILLATTE_DOMENER=

# Sett denne hvis appen kjører bak en proxy med et annet offentlig
# domene enn det Node selv ser (vanlig med Docker/reverse proxy-oppsett).
# La stå tom for å auto-oppdage fra innkommende forespørsler.
BASE_URL=
